<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="10" alignment="TOP_CENTER"
      fx:controller="cine_sistema_reservas.controlador.ButacasController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <Label fx:id="encabezado" text="Función"/>
    <Label text="PANTALLA"/>
    <GridPane fx:id="grilla" hgap="5" vgap="5" alignment="CENTER"/>
    <Label text="Blanca: disponible | Azul: seleccionada | Gris tachada: ocupada"/>
    <Label fx:id="resumen" text="Butacas: -"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="← Volver" onAction="#volver"/>
        <Button fx:id="botonContinuar" text="Continuar →" onAction="#continuar" disable="true"/>
    </HBox>
</VBox>